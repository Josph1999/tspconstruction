rules_version = '2';

// Deploy: Firebase Console → Firestore Database → Rules → paste & publish
//   or: firebase deploy --only firestore:rules
//
// Model: any authenticated Firebase user is treated as an admin (write).
// Public read is allowed so the marketing site can render projects.
// Tighten by restricting on uid or custom claim once stable.

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /inquiries/{inquiryId} {
      allow read, update, delete: if request.auth != null;
      allow create: if true;
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
