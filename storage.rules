rules_version = '2';

// Deploy: Firebase Console → Storage → Rules → paste & publish
//   or: firebase deploy --only storage
//
// Public read is enabled so uploaded images render on the marketing site.
// Writes require auth. 10 MB cap per upload to prevent abuse.

service firebase.storage {
  match /b/{bucket}/o {

    match /projects/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
